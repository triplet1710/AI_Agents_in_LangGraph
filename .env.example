# Copy file này thành .env rồi điền key. KHÔNG commit .env lên git.

# ---- Model (định dạng "provider:model", dùng cho init_chat_model) ----
# Mặc định: chạy local bằng Ollama — miễn phí, không cần key.
MODEL=ollama:qwen3:8b
# Khi nào có API trả phí / free tier cloud thì đổi:
# MODEL=google_genai:gemini-2.5-flash     (free tier, không cần thẻ)
# MODEL=openai:gpt-4o-mini
# MODEL=anthropic:claude-haiku-5-5
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Search — Tavily free tier, đăng ký KHÔNG cần thẻ: https://tavily.com ----
# Để trống thì dùng DuckDuckGo thay thế (xem lessons/00_setup.md)
TAVILY_API_KEY=

# ---- LangSmith tracing — gói free, không cần thẻ: https://smith.langchain.com ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-course
